+++ b/src/main/java/club/voting/Round.java
@@ -1,15 +1,31 @@
 package club.voting;
 
 import java.util.*;
+import java.util.function.Predicate;
 
 public class Round {
     private final String proposal;
+    private final Set<String> eligible;
+    private final Predicate<String> currentlyMember;
     private final Map<String, Boolean> votes = new HashMap<>();
     private boolean closed;
 
-    Round(String proposal) { this.proposal = proposal; }
+    Round(String proposal, Set<String> eligible, Predicate<String> currentlyMember) {
+        this.proposal = proposal;
+        this.eligible = eligible;
+        this.currentlyMember = currentlyMember;
+    }
 
-    public void vote(String member, boolean yes) { votes.put(member, yes); }
+    public VoteResult vote(String member, boolean yes) {
+        if (eligible.contains(member)) {
+            votes.put(member, yes);
+            return new VoteResult.Accepted();
+        }
+        if (currentlyMember.test(member)) {
+            return new VoteResult.Refused("joined after this round opened");
+        }
+        return new VoteResult.Refused("not a member");
+    }
 
     public void close() { closed = true; }
 
