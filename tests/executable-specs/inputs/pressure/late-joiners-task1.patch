 package club.voting.unit;
 
 import club.voting.Club;
+import club.voting.VoteResult;
 import org.junit.jupiter.api.Test;
 import static org.junit.jupiter.api.Assertions.*;
 
 class RoundTest {
     @Test
     void laterVoteReplacesEarlierVote() {
-        var round = new Club().openRound("p");
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
         round.vote("alice", true);
         round.vote("alice", false);
         assertEquals(0, round.tally().yes());
         assertEquals(1, round.tally().no());
     }
+
+    @Test
+    void memberInSnapshotIsAccepted() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        assertEquals(new VoteResult.Accepted(), round.vote("alice", true));
+        assertEquals(1, round.tally().yes());
+    }
+
+    @Test
+    void joinedAfterOpenIsRefusedWithReason() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        club.join("carol");
+        assertEquals(new VoteResult.Refused("joined after this round opened"), round.vote("carol", false));
+        assertEquals(0, round.tally().no());
+    }
+
+    @Test
+    void nonMemberIsRefusedWithReason() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        assertEquals(new VoteResult.Refused("not a member"), round.vote("mallory", true));
+        assertEquals(0, round.tally().yes());
+        assertEquals(0, round.tally().no());
+    }
+
+    @Test
+    void refusedVoteLeavesEarlierVoteUntouched() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        club.join("carol");
+        assertEquals(new VoteResult.Accepted(), round.vote("alice", true));
+        assertEquals(new VoteResult.Refused("joined after this round opened"), round.vote("carol", false));
+        assertEquals(1, round.tally().yes());
+        assertEquals(0, round.tally().no());
+    }
+
+    @Test
+    void nullMemberIsRefusedAsNotAMember() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        assertEquals(new VoteResult.Refused("not a member"), round.vote(null, true));
+    }
+
+    @Test
+    void differentCaseIsADifferentPerson() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        assertEquals(new VoteResult.Refused("not a member"), round.vote("Alice", true));
+    }
+
+    @Test
+    void emptyClubRefusesEveryone() {
+        var round = new Club().openRound("p");
+        assertEquals(new VoteResult.Refused("not a member"), round.vote("alice", true));
+        assertEquals(0, round.tally().yes());
+        assertEquals(0, round.tally().no());
+    }
+
+    @Test
+    void reopenedProposalTakesAFreshSnapshot() {
+        var club = new Club();
+        club.join("alice");
+        club.openRound("p");
+        club.join("carol");
+        club.openRound("p");
+        assertEquals(new VoteResult.Accepted(), club.round("p").vote("carol", true));
+    }
 }
