diff --git a/src/test/java/club/voting/unit/RoundEligibilityTest.java b/src/test/java/club/voting/unit/RoundEligibilityTest.java
new file mode 100644
index 0000000..70fd31f
--- /dev/null
+++ b/src/test/java/club/voting/unit/RoundEligibilityTest.java
@@ -0,0 +1,111 @@
+package club.voting.unit;
+
+import club.voting.Club;
+import club.voting.Round;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class RoundEligibilityTest {
+    private static final String LATE = "joined after this round opened";
+    private static final String NOT_MEMBER = "not a member";
+
+    @Test
+    void memberInSnapshotIsAccepted() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+
+        Round.VoteResult result = round.vote("alice", true);
+
+        assertTrue(result.accepted());
+        assertNull(result.reason());
+        assertEquals(new Round.Tally(1, 0), round.tally());
+    }
+
+    @Test
+    void joinedAfterOpenIsRefusedWithReason() {
+        var club = new Club();
+        var round = club.openRound("p");
+        club.join("carol");
+
+        Round.VoteResult result = round.vote("carol", false);
+
+        assertFalse(result.accepted());
+        assertEquals(LATE, result.reason());
+        assertEquals(new Round.Tally(0, 0), round.tally());
+    }
+
+    @Test
+    void nonMemberIsRefusedWithReason() {
+        var round = new Club().openRound("p");
+
+        Round.VoteResult result = round.vote("mallory", true);
+
+        assertFalse(result.accepted());
+        assertEquals(NOT_MEMBER, result.reason());
+        assertEquals(new Round.Tally(0, 0), round.tally());
+    }
+
+    @Test
+    void nullMemberIsRefused() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+
+        Round.VoteResult result = round.vote(null, true);
+
+        assertFalse(result.accepted());
+        assertEquals(NOT_MEMBER, result.reason());
+        assertEquals(new Round.Tally(0, 0), round.tally());
+    }
+
+    @Test
+    void emptyClubRefusesEveryone() {
+        var round = new Club().openRound("p");
+
+        Round.VoteResult result = round.vote("alice", true);
+
+        assertFalse(result.accepted());
+        assertEquals(NOT_MEMBER, result.reason());
+    }
+
+    @Test
+    void repeatedLateVotesNeverCount() {
+        var club = new Club();
+        var round = club.openRound("p");
+        club.join("carol");
+
+        Round.VoteResult first = round.vote("carol", true);
+        Round.VoteResult second = round.vote("carol", false);
+
+        assertFalse(first.accepted());
+        assertFalse(second.accepted());
+        assertEquals(new Round.Tally(0, 0), round.tally());
+    }
+
+    @Test
+    void refusedVoteLeavesOtherVotesUntouched() {
+        var club = new Club();
+        club.join("alice");
+        var round = club.openRound("p");
+        club.join("carol");
+
+        round.vote("alice", true);
+        round.vote("carol", false);
+
+        assertEquals(new Round.Tally(1, 0), round.tally());
+    }
+
+    @Test
+    void nextRoundSnapshotIncludesEarlierLateJoiner() {
+        var club = new Club();
+        club.openRound("a");
+        club.join("carol");
+        var roundB = club.openRound("b");
+
+        Round.VoteResult result = roundB.vote("carol", true);
+
+        assertTrue(result.accepted());
+        assertEquals(new Round.Tally(1, 0), roundB.tally());
+    }
+}
