+        this.isCurrentMember = isCurrentMember;
+    }
 
-    public void vote(String member, boolean yes) { votes.put(member, yes); }
+    public VoteResult vote(String member, boolean yes) {
+        if (member != null && eligibleMembers.contains(member)) {
+            votes.put(member, yes);
+            return VoteResult.ok();
+        }
+        if (member != null && isCurrentMember.test(member)) {
+            return VoteResult.refused("joined after this round opened");
+        }
+        return VoteResult.refused("not a member");
+    }
 
     public void close() { closed = true; }
 
