 package club.voting;
 
 import java.util.*;
+import java.util.function.Predicate;
 
 public class Round {
     private final String proposal;
+    private final Set<String> eligibleMembers;
+    private final Predicate<String> isCurrentMember;
     private final Map<String, Boolean> votes = new HashMap<>();
     private boolean closed;
 
-    Round(String proposal) { this.proposal = proposal; }
+    Round(String proposal, Set<String> eligibleMembers, Predicate<String> isCurrentMember) {
